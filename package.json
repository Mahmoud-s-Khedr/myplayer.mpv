{
  "name": "myplayer",
  "productName": "MyPlayer",
  "version": "0.1.0",
  "description": "Local-first desktop music player with YouTube discovery, mpv playback and smart offline caching",
  "private": true,
  "main": "out/main/index.js",
  "author": {
    "name": "MyPlayer",
    "email": "noreply@example.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "homepage": "https://github.com/local/myplayer",
  "build": {
    "appId": "app.myplayer.desktop",
    "productName": "MyPlayer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo;Audio;Player",
      "icon": "icon.png",
      "synopsis": "Local-first music player with YouTube discovery",
      "description": "Search YouTube, play audio through mpv, and keep Creative Commons tracks offline automatically.",
      "desktop": {
        "entry": {
          "Name": "MyPlayer",
          "Comment": "Local-first music player",
          "Keywords": "music;player;youtube;mpv;audio;",
          "StartupWMClass": "MyPlayer"
        }
      },
      "syncDesktopName": true
    },
    "rpm": {
      "depends": [
        "mpv",
        "yt-dlp",
        "ffmpeg-free"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "appImage": {
      "artifactName": "MyPlayer-${version}.AppImage"
    },
    "deb": {
      "depends": [
        "mpv",
        "yt-dlp",
        "ffmpeg",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "myplayer.desktop"
}